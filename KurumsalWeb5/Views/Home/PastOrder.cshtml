@model IEnumerable<KurumsalWeb5.Models.Model.PastOrder>

@{
    ViewBag.Title = "PastOrder";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<script>
    $(document).ready(function () {
        $('#myTable').DataTable(
            {
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/9dcbecd42ad/i18n/Turkish.json"
                }
            }


        );
    });
</script>

<section id="inner-headline">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <ul class="breadcrumb">
                    <li><a href="#"><i class="fa fa-home"></i></a><i class="icon-angle-right"></i></li>
                    <li class="active">Geçmiş Siparişler</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<div class="container">
    <p>
        <a href="/Urunler">Ürünlere Geri Git</a>
    </p>

    <table id="myTable" class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.category.CategoryName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.category.CategoryName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ProductName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.quantity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PriceSum)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Time)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {

                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.category.CategoryName)
                    </td>
                    <td>
                        <img width="100" height="100" src="@item.category.PhotoURL" />
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.quantity)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PriceSum)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Time)
                    </td>
                    <td>
                        @Html.ActionLink("Kaldır", "DeletePastOrder", new { id = item.PastOrderId })
                    </td>
                </tr>

            }
        </tbody>
    </table>
</div>
<script src="~/Scripts/DataTables/jquery.dataTables.js"></script>
<link href="~/Content/DataTables/css/jquery.dataTables.css" rel="stylesheet" />
<link href="~/Content/DataTables/css/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Scripts/DataTables/dataTables.bootstrap4.js"></script>