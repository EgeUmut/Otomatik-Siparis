@model IEnumerable<KurumsalWeb5.Models.Model.Blog>
@using KurumsalWeb5.Helper;



@foreach (var item in Model)
{
<li>
    <img src="@item.ResimURL" class="pull-left" alt="@item.Baslik" />
    <h6><a href="/BlogPost/@SeoHelper.ToSeoUrl(item.Baslik).ToLower()-@item.BlogId">@item.Baslik</a></h6>
    <p>
        @Html.Raw(item.Icerik.Substring(0, 150));
    </p>
</li>
}

