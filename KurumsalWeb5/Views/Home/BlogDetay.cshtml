@model KurumsalWeb5.Models.Model.Blog

@{
    ViewBag.Title = "BlogDetay";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<section id="inner-headline">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <ul class="breadcrumb">
                    <li><a href="/BlogPost/"><i class="fa fa-home"></i></a><i class="icon-angle-right"></i></li>
                    <li class="active">@Resources.Lang.Blog_Detail</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section id="content">
    <div class="container"> 
        <div class="row">
            <div class="col-lg-8">
                
                
                    <article>
                        <div class="post-image">
                            <div class="post-heading">
                                <h3>@Model.Baslik</h3>
                            </div>
                            <div class="bottom-article">
                                <ul class="meta-post">
                                    <li><i class="icon-folder-open"></i><a href="#"> @Model.kategori.KategoriAd</a></li>
                                    @*<li><i class="icon-comments"></i><a href="#">4 Comments</a></li>*@
                                </ul>
                            </div>
                            <img src="@Model.ResimURL" alt="@Model.Baslik" />
                        </div>
                        <p>
                            @Html.Raw(Model.Icerik)
                        </p>
                        
                    </article>

                    <div class="row">
                        <div class="col-md-8">
                            <h3>@Resources.Lang.Comments</h3>
                            <form>
                                <div>
                                    <input type="text" name="" id="adsoyad" class="form-control" placeholder="@Resources.Lang.Name_LastName" required />
                                    <br />
                                    <input type="email" name="name" id="eposta" class="form-control" required placeholder="@Resources.Lang.Email" value="" />
                                    <br />
                                    <textarea typeof="text" id="icerik" class="form-control" placeholder="@Resources.Lang.Your_Comment"></textarea>
                                    <br />
                                    <button type="submit" class="btn btn-success" id="gonder" value="Yorum Yap">@Resources.Lang.Comment</button>
                                </div>
                            </form>
                        </div>
                    </div>
                
                    <div class="row">
                        <div>
                            <h3>@Resources.Lang.Comments</h3>
                            @foreach (var item in Model.Yorum.OrderByDescending(p=>p.YorumId).Where(p=>p.Onay == true))
                            {
                                <p>@item.AdSoyad - @item.Eposta</p>
                                <p>@item.Icerik</p>
                                <hr />
                            }
                        </div>
                    </div>

                
            </div>
            <div class="col-lg-4">
                <aside class="right-sidebar">
                    <div class="widget">
                        <form class="form-search">
                            <input class="form-control" type="text" placeholder="Search..">
                        </form>
                    </div>
                    <div class="widget">
                        <h5 class="widgetheading">@Resources.Lang.Categories</h5>

                        @{
                            Html.RenderAction("BlogKategoriPartial", "Home");
                        }

                    </div>
                    <div class="widget">
                        <h5 class="widgetheading">@Resources.Lang.Latest_Blogs</h5>
                        <ul class="recent">
                            @{
                                Html.RenderAction("BlogKayıtPartial", "Home");
                            }
                        </ul>
                    </div>

                </aside>
            </div>
        </div>
    </div>
</section>

<script src="~/Content/SiteLayout/js/jquery.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $("#gonder").click(function () {
            var adisoyadi = $('#adsoyad').val();
            var eposta = $('#eposta').val();
            var icerik = $('#icerik').val();
            $.ajax({
                url: '/Home/YorumYap/',
                data: { adsoyad: adisoyadi, eposta: eposta, icerik: icerik, blogid:@Model.BlogId},
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    alert('Yorumunuz eklendi, Kontrolden sonra yayınlanacaktır.');
                }
            });
        });
    })
    

</script>

